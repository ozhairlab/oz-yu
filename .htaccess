# ============================================================
#  .htaccess - Root Aplikasi
#  Keamanan umum untuk shared hosting
# ============================================================

# Sembunyikan daftar isi direktori
Options -Indexes

# Tolak akses langsung ke file sensitif
<FilesMatch "^(koneksi|schema)\.php$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Proteksi file .htaccess itu sendiri
<Files ".htaccess">
    Order Allow,Deny
    Deny from all
</Files>

# Aktifkan rewrite engine (opsional, untuk URL cantik di masa depan)
<IfModule mod_rewrite.c>
    RewriteEngine On
</IfModule>

# Header keamanan HTTP dasar
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
